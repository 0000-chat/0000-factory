{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": ["../../*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/main.tsx",
    "src/router.tsx",
    "src/router-context.ts",
    "src/routes/**/*.tsx",
    "src/features/contracts.ts",
    "src/snapshot.ts"
  ]
}
